{
  "name": "@cuidarte/api",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reference-data": "tsx src/database/import-cie10.ts",
    "db:reference-data:ubicaciones": "tsx src/database/import-ubicaciones.ts",
    "db:reference-data:eps": "tsx src/database/import-eps.ts",
    "db:backfill:ubicaciones": "tsx src/database/backfill-ubicaciones.ts",
    "db:backfill:eps": "tsx src/database/backfill-eps.ts",
    "db:backfill:eps:write": "tsx src/database/backfill-eps.ts --write",
    "db:bootstrap:eps": "tsx src/database/bootstrap-eps.ts",
    "db:bootstrap": "pnpm db:migrate && pnpm db:reference-data && pnpm db:reference-data:ubicaciones && pnpm db:backfill:ubicaciones && pnpm db:bootstrap:eps",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:login": "tsx src/database/seed-login.ts",
    "db:seed:cie10": "tsx src/database/seed-cie10.ts",
    "db:seed:ubicaciones": "tsx src/database/seed-ubicaciones.ts",
    "db:seed:eps": "tsx src/database/seed-eps.ts",
    "db:seed:eps:demo": "tsx src/database/seed-eps-demo.ts",
    "dev": "nest start --watch",
    "pdf:install-deps": "playwright install chromium && playwright install-deps chromium",
    "start:e2e": "nest build && node dist/main.js",
    "start": "node dist/main.js",
    "lint": "echo \"lint pendiente para @cuidarte/api\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cuidarte/contracts": "workspace:*",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/swagger": "^11.2.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "playwright": "^1.59.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cuidarte/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^20.19.37",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
